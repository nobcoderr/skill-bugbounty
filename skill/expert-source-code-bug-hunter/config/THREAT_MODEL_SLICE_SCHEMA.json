{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex.invalid/schemas/threat-model-slice.json",
  "title": "Threat Model Slice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice_id",
    "scope",
    "attacker_model",
    "protected_property",
    "trust_boundary",
    "entrypoints",
    "crown_jewel_consumers",
    "invariants",
    "verification_plan",
    "context_budget"
  ],
  "properties": {
    "slice_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "release"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "release": {"type": "string", "minLength": 1}
      }
    },
    "attacker_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starting_authority", "controlled_inputs", "unavailable_capabilities"],
      "properties": {
        "starting_authority": {"type": "array", "items": {"type": "string"}},
        "controlled_inputs": {"type": "array", "items": {"type": "string"}},
        "unavailable_capabilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "protected_property": {"type": "string", "minLength": 1},
    "trust_boundary": {"type": "string", "minLength": 1},
    "entrypoints": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "crown_jewel_consumers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant", "source_evidence", "falsifier"],
        "properties": {
          "invariant": {"type": "string"},
          "source_evidence": {"type": "array", "items": {"type": "string"}},
          "falsifier": {"type": "string"}
        }
      }
    },
    "verified_facts": {"type": "array", "items": {"type": "string"}},
    "failed_assumptions": {"type": "array", "items": {"type": "string"}},
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "negative_control", "deterministic_oracle", "cleanup"],
      "properties": {
        "baseline": {"type": "string"},
        "negative_control": {"type": "string"},
        "deterministic_oracle": {"type": "string"},
        "cleanup": {"type": "string"}
      }
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_scaffold", "target_evidence", "verification"],
      "properties": {
        "stable_scaffold": {"type": "string"},
        "target_evidence": {"type": "string"},
        "verification": {"type": "string"}
      }
    },
    "status": {
      "enum": ["MAPPED", "ACTIVE", "EXHAUSTED", "BLOCKED", "NO_WITNESS", "CANDIDATE"]
    }
  }
}
