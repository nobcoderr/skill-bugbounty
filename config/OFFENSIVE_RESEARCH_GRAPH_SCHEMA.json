{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/offensive-research-graph.schema.json",
  "title": "Offensive Research Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "authorization", "budgets", "nodes", "edges", "anchors", "status"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "scope", "multi_agent_explicit", "allowed_actions", "stop_conditions"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "multi_agent_explicit": {"const": true},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "max_concurrency", "max_retries_per_node", "max_zero_evidence_waves"],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_retries_per_node": {"type": "integer", "minimum": 0},
        "max_zero_evidence_waves": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "role", "scope_slice", "workspace", "immutable_inputs", "required_outputs", "oracle", "status"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["scope", "mapper", "discovery", "triage", "primitive_proof", "capability_expansion", "severity_escalation", "verifier", "judge", "human_gate"]},
          "scope_slice": {"type": "string", "minLength": 1},
          "workspace": {"type": "string", "minLength": 1},
          "immutable_inputs": {"type": "array", "items": {"type": "string"}},
          "required_outputs": {"type": "array", "items": {"type": "string"}},
          "oracle": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "READY", "RUNNING", "PASS", "FAIL", "BLOCKED", "KILLED"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "producer_output", "consumer_requirement", "match_proof"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "producer_output": {"type": "string", "minLength": 1},
          "consumer_requirement": {"type": "string", "minLength": 1},
          "match_proof": {"type": "string", "minLength": 1}
        }
      }
    },
    "anchors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["GRAPH_VALIDATED", "GRAPH_PARTIAL", "GRAPH_NOT_NEEDED", "GRAPH_ABORTED"]}
  }
}
